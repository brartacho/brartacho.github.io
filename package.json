{
  "name": "portfolio-artacho",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jobsync": "./cli/jobsync.mjs"
  },
  "scripts": {
    "test": "playwright test",
    "jobsync": "node cli/jobsync.mjs",
    "mcp:setup":   "powershell -ExecutionPolicy Bypass -File scripts/setup-mcp-daemon.ps1",
    "mcp:start":   "pm2 start ecosystem.config.cjs",
    "mcp:stop":    "pm2 stop radar-mcp",
    "mcp:restart": "pm2 restart radar-mcp",
    "mcp:status":  "pm2 status",
    "mcp:logs":    "pm2 logs radar-mcp --lines 50"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@playwright/test": "^1.59.1",
    "pdf-lib": "^1.17.1",
    "serve": "^14.2.6",
    "wait-on": "^8.0.5",
    "zod": "^3.23.8"
  }
}
